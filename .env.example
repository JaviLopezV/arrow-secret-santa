# URL pública real, sin barra final. Opcional en desarrollo.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio-real
# Sin ella: VERCEL_PROJECT_PRODUCTION_URL o http://localhost:3000
# Token opcional de verificación HTML de Google Search Console (configurar antes del build).
GOOGLE_SITE_VERIFICATION=

# Solo servidor. Configurar en .env.local o en el hosting.
# Tu cuenta Gmail y una contraseña de aplicación de Google (no la contraseña habitual).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Redis persistente compartido para mantener el mismo sorteo en reintentos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Límite global diario de destinatarios nuevos (UTC).
EMAIL_DAILY_LIMIT=100

# Identidad pública del titular. Los valores por defecto son los facilitados por el titular.
# Estos campos se publican en los documentos legales; no incluir secretos.
LEGAL_OWNER_NAME=
LEGAL_TAX_ID=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
# Indicar datos registrales o "No aplicable: persona física no inscrita", si es correcto.
LEGAL_REGISTRY=
# Entidad contratada y ubicación efectiva del alojamiento.
LEGAL_HOSTING="Vercel Inc., con ejecución de las funciones del servidor en Frankfurt, Alemania (fra1), y distribución de contenido estático mediante su red global."
# Confirmado: Upstash AWS eu-central-1 (Frankfurt) y Gmail personal.
# Entidades/regiones, mecanismo de transferencia verificado y acceso a sus garantías.
LEGAL_TRANSFERS=
# Procedimiento manual: docs/legal/procedimiento-borrado.md.
# Plazos concretos aprobados Y aplicados: Redis pendiente/recibos, Gmail, logs y backups.
LEGAL_RETENTION=
